rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /profiles/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow get: if signedIn();
      allow list, delete: if false;
    }

    // Exact email lookup only: clients cannot enumerate the user directory.
    match /user_lookup/{email} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn();
      allow list, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2;
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }
  }
}